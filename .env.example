# Copy this file to .env before starting anything.
# Defaults target local development. See docs/local-setup.md for startup commands
# and CEM_SETUP_GUIDE.md for production URLs, credentials, and proxy overrides.
# For compute env, deployed URLs, FileBrowser settings, Make Public commands,
# and indexer verification, see:
#   docs/first-time-local-publication.md
#
# LOG_LEVEL: debug | info | error (Default: info)
# DEBUG=true is also supported as an alias for LOG_LEVEL=debug; see DEBUGGING.md.
LOG_LEVEL=info
DEBUG=false
#
#     cp .env.example .env
#
# Docker Compose reads .env automatically from the project directory, so once it
# exists every `docker compose ...` command works in any terminal. compose.yaml
# declares DATABASE_URL with `:?`, which fails hard when it is unset.

# --- Required by Docker Compose --------------------------------------------
# Host port on which the unified container (Frontend UI + REST API) is exposed:
PORT=8000
# PostgreSQL service hostname must be cem-database on cem_master_network.
# This is the CONTAINER's view: the host is the compose service name, not
# localhost, which inside a container would be the container itself.
DATABASE_URL=postgresql+psycopg://cem_user:change-me@cem-database:5432/cem_master
# Compose passes this into the app as CORS_ORIGINS.
# Local browser origins; use the deployed origin from CEM_SETUP_GUIDE.md on the server.
BACKEND_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Compose passes this into the app as CEM_MASTER_API_KEY. Optional.
BACKEND_API_KEY=
# Shared DATA_DIR from the compute backend. The master backend/indexer mount it
# read-only and only index projects whose project.json says visibility=public.
# This must be the same physical folder/volume compute writes.
CEM_DATA_DIR_HOST=../cem-backend/data
INDEXER_POLL_SECONDS=30

# ---- Frontend (Mounted into the single backend container) ----
# Sibling checkout folder containing index.html, js, styles, and leaflet assets.
MASTER_FRONTEND_CONTEXT=../cem-master-frontend
# Optional. Leave blank for same-origin API calls (default). In cluster deployments with
# reverse proxy path prefixes or distinct API domains, set API_BASE_URL (e.g. https://api.cem.example.com).
API_BASE_URL=
# External compute UI URL used by the "Do Your Own CEM" link. In deployment,
# use the public compute UI origin.
COMPUTE_FRONTEND_URL=http://127.0.0.1:8080/
# Optional. Base URL of FileBrowser as a VISITOR'S BROWSER reaches it, used to
# turn share hashes from job.json into download links on the Analysis jobs
# table. NOT the compute app's FILEBROWSER_BASE_URL (http://filebrowser:80),
# which is container-internal and dead in a browser.
#
# Local FileBrowser URL when that optional service/shares are enabled.
# Leave blank when unused; use its public HTTPS URL for deployment.
FILEBROWSER_PUBLIC_URL=http://localhost:8097

# --- Used by pytest, running on YOUR machine --------------------------------
# Host is localhost here, because the database port is published to the host and
# the tests use the throwaway database created by scripts/initdb.
# Compose does not export this to your shell; load it with:
#     set -a && source .env && set +a
TEST_DATABASE_URL=postgresql+psycopg://cem_user:change-me@localhost:5432/cem_master_test
